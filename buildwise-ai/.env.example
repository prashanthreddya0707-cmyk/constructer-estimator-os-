# ---- Backend (copy to backend/.env) -------------------------------------------------
# SQLite by default. For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/buildwise
DATABASE_URL=sqlite:///./data/buildwise.db
# REQUIRED for any shared/deployed environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty in local development a random secret is generated into backend/data/.dev_jwt_secret
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_MB=10
SEED_SAMPLE_DATA=true

# ---- Frontend (copy to frontend/.env) ------------------------------------------------
# Leave empty to use the Vite dev proxy (/api -> http://localhost:8000)
VITE_API_BASE_URL=
