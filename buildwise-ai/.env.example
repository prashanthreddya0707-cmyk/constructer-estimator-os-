# ---- Backend (copy to backend/.env). Never commit real values. -------------------------
# Database. SQLite by default (two files in DATA_DIR). For PostgreSQL / Supabase use the Session pooler URL, e.g.
#   postgresql://postgres.<project>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./data/buildwise.db
# Optional: credentials in a separate database. Default: data/auth.db (SQLite) or the same server as DATABASE_URL.
AUTH_DATABASE_URL=
# REQUIRED for any shared/deployed environment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty in local development a random secret is generated into backend/data/.dev_jwt_secret
JWT_SECRET=
# Key that encrypts the e-mail/name in the credential store. Keep it safe: without it those fields cannot be read.
# If empty in local development a key is generated into backend/data/.auth_key
AUTH_ENCRYPTION_KEY=
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_MB=10
SEED_SAMPLE_DATA=true

# Security / abuse protection
RATE_LIMIT_ENABLED=true
LOGIN_IP_LIMIT=30            # login attempts per IP per 5 minutes
LOGIN_FAIL_LIMIT=8           # failed logins per (account, IP) per 15 minutes before a temporary block
SIGNUP_IP_LIMIT=10           # sign-ups per IP per hour
EXPENSIVE_USER_LIMIT=40      # PDF reports / estimate recalculation / plan analysis per user per minute
TRUST_PROXY_HEADERS=false    # true behind Render/Netlify so the real client IP (X-Forwarded-For) is used for limits
HSTS=false                   # true when served over HTTPS directly

# Database pool and timeouts (server databases)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10           # seconds to wait for a free connection before answering 503
DB_STATEMENT_TIMEOUT_MS=15000
SLOW_REQUEST_MS=1000         # requests slower than this are logged

# ---- Frontend (copy to frontend/.env) ------------------------------------------------
# Leave empty to use the Vite dev proxy (/api -> http://localhost:8000)
VITE_API_BASE_URL=
